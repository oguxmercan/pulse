<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#D90A0E14" CornerRadius="8" BorderBrush="#1FFFFFFF" BorderThickness="1"
            Padding="12,6" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding Fps, StringFormat='{}{0:F0}', TargetNullValue='--'}"
                       FontFamily="Consolas, Cascadia Mono" FontSize="17" FontWeight="Bold" Foreground="#54E6A8" />
            <TextBlock Text="fps" FontFamily="Consolas, Cascadia Mono" FontSize="11" Foreground="#7FB9A0"
                       Margin="5,0,0,2" VerticalAlignment="Bottom" />

            <TextBlock Text="|" Foreground="#2E3A4A" Margin="10,0" />
            <TextBlock Text="{Binding Frametime, StringFormat='{}{0:F1} ms', TargetNullValue='—'}"
                       FontFamily="Consolas, Cascadia Mono" FontSize="11" Foreground="#8FA0B8" VerticalAlignment="Center" />

            <TextBlock Text="|" Foreground="#2E3A4A" Margin="10,0" />
            <TextBlock Text="CPU" FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="#5E6C7E" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CpuTemp, StringFormat=' {0:F0}°', TargetNullValue=' --'}"
                       FontFamily="Consolas, Cascadia Mono" FontSize="11" Foreground="#7FD1FF" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CpuLoad, StringFormat='{}{0:F0}%', TargetNullValue=''}"
                       FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="#4E6E86" VerticalAlignment="Center" Margin="4,0,0,0" />

            <TextBlock Text="|" Foreground="#2E3A4A" Margin="10,0" />
            <TextBlock Text="GPU" FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="#5E6C7E" VerticalAlignment="Center" />
            <TextBlock Text="{Binding GpuTemp, StringFormat=' {0:F0}°', TargetNullValue=' --'}"
                       FontFamily="Consolas, Cascadia Mono" FontSize="11" Foreground="#FFB86B" VerticalAlignment="Center" />
            <TextBlock Text="{Binding GpuLoad, StringFormat='{}{0:F0}%', TargetNullValue=''}"
                       FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="#8A6A46" VerticalAlignment="Center" Margin="4,0,0,0" />

            <TextBlock Text="|" Foreground="#2E3A4A" Margin="10,0" />
            <TextBlock Text="{Binding RamUsed, StringFormat='{}{0:F1} GB', TargetNullValue='--'}"
                       FontFamily="Consolas, Cascadia Mono" FontSize="11" Foreground="#9DFFB0" VerticalAlignment="Center" />

            <TextBlock Text="|" Foreground="#2E3A4A" Margin="10,0" />
            <TextBlock Text="{Binding GpuShort, StringFormat='GPU {0}', TargetNullValue=''}"
                       FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="#5E6C7E" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CpuShort, StringFormat=' · {0}', TargetNullValue=''}"
                       FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="#4C5A6B" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</DataTemplate>

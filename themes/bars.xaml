<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#E6101420" CornerRadius="10" BorderBrush="#2AFFFFFF" BorderThickness="1"
            Padding="14,10" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel Width="270">
            <Grid Margin="0,0,0,8">
                <TextBlock Text="{Binding Target}" FontSize="10" Foreground="#7C8CA6" VerticalAlignment="Bottom" />
                <TextBlock Text="{Binding Fps, StringFormat='{}{0:F0} fps', TargetNullValue='--'}"
                           FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <TextBlock Text="CPU" FontSize="9" Foreground="#7C8CA6" />
                <TextBlock Text="{Binding CpuTemp, StringFormat='{}{0:F0}°C', TargetNullValue='--'}"
                           FontSize="9" Foreground="#7FD1FF" HorizontalAlignment="Right" />
            </Grid>
            <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding CpuLoad, TargetNullValue=0}"
                         Foreground="#3FA9F5" Background="#1AFFFFFF" BorderThickness="0" />
            <Grid Margin="0,8,0,6">
                <TextBlock Text="GPU" FontSize="9" Foreground="#7C8CA6" />
                <TextBlock Text="{Binding GpuTemp, StringFormat='{}{0:F0}°C', TargetNullValue='--'}"
                           FontSize="9" Foreground="#FFB86B" HorizontalAlignment="Right" />
            </Grid>
            <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding GpuLoad, TargetNullValue=0}"
                         Foreground="#F5A623" Background="#1AFFFFFF" BorderThickness="0" />
            <Grid Margin="0,8,0,6">
                <TextBlock Text="RAM" FontSize="9" Foreground="#7C8CA6" />
                <TextBlock Text="{Binding RamUsed, StringFormat='{}{0:F1} GB', TargetNullValue='--'}"
                           FontSize="9" Foreground="#9DFFB0" HorizontalAlignment="Right" />
            </Grid>
            <ProgressBar Height="4" Minimum="0" Maximum="64" Value="{Binding RamUsed, TargetNullValue=0}"
                         Foreground="#54E6A8" Background="#1AFFFFFF" BorderThickness="0" />
            <Grid Margin="0,10,0,0">
                <TextBlock Text="{Binding GpuShort, TargetNullValue=''}" FontSize="10" Foreground="#6E7F94"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CpuShort, TargetNullValue=''}" FontSize="10" Foreground="#57667B"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            </Grid>
        </StackPanel>
    </Border>
</DataTemplate>

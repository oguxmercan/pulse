<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#E60F1320" CornerRadius="12" BorderBrush="#2EFFFFFF" BorderThickness="1"
            Padding="12" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding Fps, StringFormat='{}{0:F0}', TargetNullValue='--'}"
                           FontSize="30" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock Text="fps" FontSize="12" Foreground="#7C8CA6" VerticalAlignment="Bottom" Margin="4,0,0,5" />
                <TextBlock Text="{Binding Frametime, StringFormat='{}{0:F1} ms', TargetNullValue=''}"
                           FontSize="11" Foreground="#7C8CA6" VerticalAlignment="Bottom" Margin="10,0,0,5" />
            </StackPanel>
            <UniformGrid Columns="3">
                <Border Background="#14FFFFFF" CornerRadius="8" Padding="8,6" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="CPU" FontSize="9" Foreground="#7C8CA6" />
                        <TextBlock Text="{Binding CpuTemp, StringFormat='{}{0:F0}°C', TargetNullValue='--'}"
                                   FontSize="16" Foreground="#7FD1FF" />
                        <TextBlock Text="{Binding CpuLoad, StringFormat='{}{0:F0}%', TargetNullValue='--'}"
                                   FontSize="10" Foreground="#8FA0B8" />
                    </StackPanel>
                </Border>
                <Border Background="#14FFFFFF" CornerRadius="8" Padding="8,6" Margin="2,0">
                    <StackPanel>
                        <TextBlock Text="GPU" FontSize="9" Foreground="#7C8CA6" />
                        <TextBlock Text="{Binding GpuTemp, StringFormat='{}{0:F0}°C', TargetNullValue='--'}"
                                   FontSize="16" Foreground="#FFB86B" />
                        <TextBlock Text="{Binding GpuLoad, StringFormat='{}{0:F0}%', TargetNullValue='--'}"
                                   FontSize="10" Foreground="#8FA0B8" />
                    </StackPanel>
                </Border>
                <Border Background="#14FFFFFF" CornerRadius="8" Padding="8,6" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="FAN" FontSize="9" Foreground="#7C8CA6" />
                        <TextBlock Text="{Binding GpuFan, StringFormat='{}{0:F0} rpm', TargetNullValue='--'}"
                                   FontSize="13" Foreground="#9DFFB0" />
                        <TextBlock Text="{Binding GpuFanPct, StringFormat='{}{0:F0}%', TargetNullValue='--'}"
                                   FontSize="10" Foreground="#8FA0B8" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Grid Margin="0,8,0,0">
                <TextBlock Text="{Binding GpuShort, TargetNullValue=''}" FontSize="10" Foreground="#6E7F94"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CpuShort, TargetNullValue=''}" FontSize="10" Foreground="#57667B"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            </Grid>
        </StackPanel>
    </Border>
</DataTemplate>

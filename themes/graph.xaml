<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#D90A0D14" CornerRadius="10" BorderBrush="#26FFFFFF" BorderThickness="1"
            Padding="14,10" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel Width="330">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Fps, StringFormat='{}{0:F0}', TargetNullValue='--'}"
                               FontSize="32" FontWeight="Bold" Foreground="#F2F6FF" />
                    <TextBlock Text="{Binding Frametime, StringFormat='{}{0:F1} ms', TargetNullValue='FPS'}"
                               FontSize="10" Foreground="#7C8CA6" />
                </StackPanel>
                <Border Grid.Column="1" Height="44" Margin="12,0,0,0" Background="#0AFFFFFF" CornerRadius="4"
                        ClipToBounds="True">
                    <Path Data="{Binding Spark}" Stroke="#54E6A8" StrokeThickness="1.6" Stretch="Fill"
                          Margin="2" />
                </Border>
            </Grid>
            <Border Height="1" Background="#1FFFFFFF" Margin="0,8" />
            <UniformGrid Columns="4">
                <StackPanel>
                    <TextBlock Text="CPU" FontSize="9" Foreground="#7C8CA6" />
                    <TextBlock Text="{Binding CpuTemp, StringFormat='{}{0:F0}°', TargetNullValue='--'}"
                               FontSize="14" Foreground="#7FD1FF" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="GPU" FontSize="9" Foreground="#7C8CA6" />
                    <TextBlock Text="{Binding GpuTemp, StringFormat='{}{0:F0}°', TargetNullValue='--'}"
                               FontSize="14" Foreground="#FFB86B" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="VRAM" FontSize="9" Foreground="#7C8CA6" />
                    <TextBlock Text="{Binding VramUsed, StringFormat='{}{0:F1} GB', TargetNullValue='--'}"
                               FontSize="14" Foreground="#B8A6FF" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="RAM" FontSize="9" Foreground="#7C8CA6" />
                    <TextBlock Text="{Binding RamUsed, StringFormat='{}{0:F1} GB', TargetNullValue='--'}"
                               FontSize="14" Foreground="#9DFFB0" />
                </StackPanel>
            </UniformGrid>
            <Grid Margin="0,8,0,0">
                <TextBlock Text="{Binding GpuShort, TargetNullValue=''}" FontSize="10" Foreground="#6E7F94"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CpuShort, TargetNullValue=''}" FontSize="10" Foreground="#57667B"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            </Grid>
        </StackPanel>
    </Border>
</DataTemplate>

<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#D90A0D14" CornerRadius="10" BorderBrush="#26FFFFFF" BorderThickness="1"
            Padding="14,6" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Fps, StringFormat='{}{0:F0}', TargetNullValue='--'}"
                       FontSize="34" FontWeight="Bold" Foreground="#F2F6FF" />
            <TextBlock Text="FPS" FontSize="11" Foreground="#8FA0B8" VerticalAlignment="Bottom" Margin="3,0,0,7" />
            <Border Width="1" Background="#26FFFFFF" Margin="14,2" />
            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="CPU" FontSize="9" Foreground="#7C8CA6" />
                <TextBlock Text="{Binding CpuTemp, StringFormat='{}{0:F0}°C', TargetNullValue='--'}"
                           FontSize="15" Foreground="#7FD1FF" />
            </StackPanel>
            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="GPU" FontSize="9" Foreground="#7C8CA6" />
                <TextBlock Text="{Binding GpuTemp, StringFormat='{}{0:F0}°C', TargetNullValue='--'}"
                           FontSize="15" Foreground="#FFB86B" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="RAM" FontSize="9" Foreground="#7C8CA6" />
                <TextBlock Text="{Binding RamUsed, StringFormat='{}{0:F1} GB', TargetNullValue='--'}"
                           FontSize="15" Foreground="#9DFFB0" />
            </StackPanel>
        </StackPanel>
            <Grid Margin="0,8,0,0">
                <TextBlock Text="{Binding GpuShort, TargetNullValue=''}" FontSize="10" Foreground="#6E7F94"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CpuShort, TargetNullValue=''}" FontSize="10" Foreground="#57667B"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            </Grid>
        </StackPanel>
    </Border>
</DataTemplate>

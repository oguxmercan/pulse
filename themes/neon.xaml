<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#E60A0E16" CornerRadius="12" BorderBrush="#3354E6A8" BorderThickness="1"
            Padding="16,12" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel Width="300">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Fps, StringFormat='{}{0:F0}', TargetNullValue='--'}"
                               FontSize="44" FontWeight="Bold" Foreground="#EBFFF8" LineHeight="46">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#54E6A8" BlurRadius="26" ShadowDepth="0" Opacity="0.85" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="FPS" FontSize="10" Foreground="#7FB9A0" Margin="3,-2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Frametime, StringFormat='{}{0:F1} ms', TargetNullValue='—'}"
                               FontSize="12" Foreground="#8FA0B8" HorizontalAlignment="Right" />
                    <TextBlock Text="kare" FontSize="9" Foreground="#5E6C7E" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <Border Height="40" Margin="0,10,0,12" ClipToBounds="True">
                <Path Data="{Binding Spark}" Stroke="#54E6A8" StrokeThickness="2" Stretch="Fill" Opacity="0.9" />
            </Border>

            <UniformGrid Columns="3">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#7FD1FF" VerticalAlignment="Center" />
                        <TextBlock Text="CPU" FontSize="9" Foreground="#7C8CA6" Margin="5,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding CpuTemp, StringFormat='{}{0:F0}°', TargetNullValue='--'}"
                               FontSize="17" Foreground="#7FD1FF" />
                    <TextBlock Text="{Binding CpuLoad, StringFormat='{}{0:F0}%', TargetNullValue=''}"
                               FontSize="9" Foreground="#617186" />
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#FFB86B" VerticalAlignment="Center" />
                        <TextBlock Text="GPU" FontSize="9" Foreground="#7C8CA6" Margin="5,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding GpuTemp, StringFormat='{}{0:F0}°', TargetNullValue='--'}"
                               FontSize="17" Foreground="#FFB86B" />
                    <TextBlock Text="{Binding GpuLoad, StringFormat='{}{0:F0}%', TargetNullValue=''}"
                               FontSize="9" Foreground="#617186" />
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#B8A6FF" VerticalAlignment="Center" />
                        <TextBlock Text="FAN" FontSize="9" Foreground="#7C8CA6" Margin="5,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding GpuFanPct, StringFormat='{}{0:F0}%', TargetNullValue='--'}"
                               FontSize="17" Foreground="#B8A6FF" />
                    <TextBlock Text="{Binding GpuFan, StringFormat='{}{0:F0} rpm', TargetNullValue=''}"
                               FontSize="9" Foreground="#617186" />
                </StackPanel>
            </UniformGrid>

            <Grid Margin="0,10,0,0">
                <TextBlock Text="{Binding GpuShort, StringFormat='GPU {0}', TargetNullValue=''}"
                           FontSize="9" Foreground="#5E6C7E" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CpuShort, StringFormat='CPU {0}', TargetNullValue=''}"
                           FontSize="9" Foreground="#4C5A6B" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </StackPanel>
    </Border>
</DataTemplate>

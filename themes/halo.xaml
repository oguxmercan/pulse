<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="18" BorderBrush="#3A7FD1FF" BorderThickness="1" Padding="20,12"
            HorizontalAlignment="Left" VerticalAlignment="Top">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#E6121B2A" Offset="0" />
                <GradientStop Color="#E60A0E16" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
        <StackPanel Orientation="Horizontal">
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="{Binding Fps, StringFormat='{}{0:F0}', TargetNullValue='--'}"
                           FontSize="38" FontWeight="Bold" Foreground="#FFFFFF" LineHeight="40" />
                <TextBlock Text="KARE / SN" FontSize="8" Foreground="#6E8095" />
            </StackPanel>

            <Border Width="1" Background="#22FFFFFF" Margin="0,4" />

            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="{Binding Frametime, StringFormat='{}{0:F1} ms', TargetNullValue='—'}"
                           FontSize="13" Foreground="#B9C7D8" />
                <TextBlock Text="kare süresi" FontSize="8" Foreground="#6E8095" />
            </StackPanel>

            <Border Width="1" Background="#22FFFFFF" Margin="16,4" />

            <UniformGrid Columns="3">
                <StackPanel Margin="6,0" VerticalAlignment="Center">
                    <TextBlock Text="CPU" FontSize="9" Foreground="#6E8095" />
                    <TextBlock Text="{Binding CpuTemp, StringFormat='{}{0:F0}°C', TargetNullValue='--'}"
                               FontSize="16" Foreground="#7FD1FF" />
                </StackPanel>
                <StackPanel Margin="6,0" VerticalAlignment="Center">
                    <TextBlock Text="GPU" FontSize="9" Foreground="#6E8095" />
                    <TextBlock Text="{Binding GpuTemp, StringFormat='{}{0:F0}°C', TargetNullValue='--'}"
                               FontSize="16" Foreground="#FFB86B" />
                </StackPanel>
                <StackPanel Margin="6,0" VerticalAlignment="Center">
                    <TextBlock Text="RAM" FontSize="9" Foreground="#6E8095" />
                    <TextBlock Text="{Binding RamUsed, StringFormat='{}{0:F1} GB', TargetNullValue='--'}"
                               FontSize="16" Foreground="#9DFFB0" />
                </StackPanel>
            </UniformGrid>
        </StackPanel>

        <TextBlock Margin="2,10,0,0" FontSize="10" Foreground="#6E7F94" TextTrimming="CharacterEllipsis">
            <Run Text="{Binding GpuShort, Mode=OneWay, TargetNullValue=''}" />
            <Run Text=" · " Foreground="#38485C" />
            <Run Text="{Binding CpuShort, Mode=OneWay, TargetNullValue=''}" />
        </TextBlock>
        </StackPanel>
    </Border>
</DataTemplate>

<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#E60C1017" CornerRadius="14" BorderBrush="#1CFFFFFF" BorderThickness="1"
            Padding="16,14" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel>
        <Grid Width="340">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Fps, StringFormat='{}{0:F0}', TargetNullValue='--'}"
                           FontSize="46" FontWeight="Bold" Foreground="#F2F6FF" LineHeight="46" />
                <TextBlock Text="{Binding Frametime, StringFormat='{}{0:F1} ms', TargetNullValue='—'}"
                           FontSize="11" Foreground="#6E8095" />
                <Border Height="3" Width="64" CornerRadius="2" Margin="0,8,0,0" HorizontalAlignment="Left">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#54E6A8" Offset="0" />
                            <GradientStop Color="#7FD1FF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="CPU" FontSize="9" Foreground="#6E8095" />
                    <TextBlock Text="{Binding CpuTemp, StringFormat='{}{0:F0}°C', TargetNullValue='--'}"
                               FontSize="9" Foreground="#7FD1FF" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding CpuLoad, TargetNullValue=0}"
                             Foreground="#7FD1FF" Background="#1AFFFFFF" BorderThickness="0" />

                <Grid Margin="0,10,0,8">
                    <TextBlock Text="GPU" FontSize="9" Foreground="#6E8095" />
                    <TextBlock Text="{Binding GpuTemp, StringFormat='{}{0:F0}°C', TargetNullValue='--'}"
                               FontSize="9" Foreground="#FFB86B" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding GpuLoad, TargetNullValue=0}"
                             Foreground="#FFB86B" Background="#1AFFFFFF" BorderThickness="0" />

                <Grid Margin="0,10,0,8">
                    <TextBlock Text="RAM" FontSize="9" Foreground="#6E8095" />
                    <TextBlock Text="{Binding RamUsed, StringFormat='{}{0:F1} GB', TargetNullValue='--'}"
                               FontSize="9" Foreground="#9DFFB0" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar Height="4" Minimum="0" Maximum="64" Value="{Binding RamUsed, TargetNullValue=0}"
                             Foreground="#9DFFB0" Background="#1AFFFFFF" BorderThickness="0" />
            </StackPanel>
        </Grid>

        <Grid Width="340" Margin="0,10,0,0">
            <TextBlock Text="{Binding GpuShort, TargetNullValue=''}" FontSize="10" Foreground="#6E7F94"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding CpuShort, TargetNullValue=''}" FontSize="10" Foreground="#57667B"
                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
        </Grid>
        </StackPanel>
    </Border>
</DataTemplate>

<ui:FluentWindow x:Class="Pulse.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Pulse" Icon="Assets/pulse.ico" Width="1240" Height="820" MinWidth="1000" MinHeight="660"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None" WindowCornerPreference="Round"
                 Background="#0B0F16"
                 FontFamily="Segoe UI Variable Text, Segoe UI">

    <ui:FluentWindow.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#99A8BA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Xbox-style sidebar item: icon + label on one row -->
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="#93A2B5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="8" Background="Transparent" Margin="0,1" Padding="11,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="G" Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14" VerticalAlignment="Center" />
                                <TextBlock x:Name="T" Text="{TemplateBinding Content}" FontSize="13"
                                           Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#9AA7B8" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#2654E6A8" />
                                <Setter TargetName="T" Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="G" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#10FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Xbox library tile: wide art, title + meta underneath -->
        <Style x:Key="Tile" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,14,20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="#0B0F16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Pulse" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Margin="10,10,0,10" CornerRadius="14" Background="#111821"
                    BorderBrush="#1CFFFFFF" BorderThickness="1">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="6,4,0,16">
                            <Image Source="Assets/logo.png" Width="32" Height="32" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Pulse" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="10" Foreground="#6F8095" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="GEZİN" FontSize="10" Foreground="#66758A" Margin="12,4,0,8" />
                        <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="Giriş"
                                     IsChecked="True" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavLibrary" Style="{StaticResource Nav}" Tag="&#xE8F1;" Content="Kütüphane"
                                     Checked="Nav_Checked" />
                        <RadioButton x:Name="NavOverlay" Style="{StaticResource Nav}" Tag="&#xE70F;" Content="Overlay"
                                     Checked="Nav_Checked" />
                        <RadioButton x:Name="NavTune" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Hız aşırtma"
                                     Checked="Nav_Checked" />
                        <RadioButton x:Name="NavAbout" Style="{StaticResource Nav}" Tag="&#xE946;" Content="Hakkında"
                                     Checked="Nav_Checked" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Background="#12FFFFFF" CornerRadius="10" Padding="12" Margin="0,10,0,8"
                                BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="SİSTEM" FontSize="10" Foreground="#6F8095" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Lbl}"
                                           Text="{Binding Metrics.CpuTemp, StringFormat='CPU {0:F0}°C', TargetNullValue='CPU --'}" />
                                <TextBlock Style="{StaticResource Lbl}"
                                           Text="{Binding Metrics.GpuTemp, StringFormat='GPU {0:F0}°C', TargetNullValue='GPU --'}" />
                                <TextBlock Style="{StaticResource Lbl}"
                                           Text="{Binding Metrics.Fps, StringFormat='{}{0:F0} fps', TargetNullValue='fps --'}" />
                                <TextBlock x:Name="LimiterStatusLine" Style="{StaticResource Lbl}" Margin="0,6,0,0"
                                           Foreground="#7FB9A0" Text="Sınırlayıcı…" />
                                <Border Height="1" Background="#14FFFFFF" Margin="0,8,0,6" />
                                <TextBlock Style="{StaticResource Lbl}" FontSize="10" Foreground="#5E6C7E"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Metrics.GpuShort, TargetNullValue='GPU —'}" />
                                <TextBlock Style="{StaticResource Lbl}" FontSize="10" Foreground="#4C5A6B"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Metrics.CpuShort, TargetNullValue='CPU —'}" />
                            </StackPanel>
                        </Border>
                        <ui:Button x:Name="OverlayButton" Content="Overlay'i gizle" Click="OverlayToggle_Click"
                                   HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <Grid />
                </DockPanel>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Xbox top bar: centered search + status on the right -->
                <Grid Grid.Row="0" Margin="24,10,24,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageTitle" Text="Giriş" FontSize="13" Foreground="#7F8FA3" VerticalAlignment="Center" />
                    <Border Grid.Column="1" MaxWidth="460" Height="32" HorizontalAlignment="Center"
                            Background="#14FFFFFF" CornerRadius="16" Padding="14,0">
                        <Grid>
                            <TextBlock Text="Oyun ara" Foreground="#66758A" FontSize="12" VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontSize="12"
                                     VerticalContentAlignment="Center" TextChanged="Search_Changed" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="2" x:Name="StatusLine" Style="{StaticResource Lbl}" MaxWidth="360"
                               TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1" Margin="24,0,24,16">

                    <!-- HOME -->
                    <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border CornerRadius="16" Height="300" ClipToBounds="True" Background="#101724">
                                <Grid>
                                    <Image Source="{Binding Featured.Hero}" Stretch="UniformToFill" VerticalAlignment="Center" />
                                    <Border>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#E6080C12" Offset="0" />
                                                <GradientStop Color="#990B0F16" Offset="0.45" />
                                                <GradientStop Color="#000B0F16" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel VerticalAlignment="Bottom" Margin="34,0,34,30" MaxWidth="520" HorizontalAlignment="Left">
                                        <TextBlock Text="SON OYNANAN" FontSize="10" Foreground="#54E6A8" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding Featured.Name}" FontSize="36" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Featured.Sub}" Style="{StaticResource Lbl}" Margin="0,6,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <ui:Button Content="Oyna" Click="HeroPlay_Click" Appearance="Primary" />
                                            <ui:Button Content="Kütüphanede gör" Click="HeroBrowse_Click" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="4" Margin="0,16,0,0">
                                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="FPS" Style="{StaticResource Lbl}" />
                                        <TextBlock Style="{StaticResource Val}"
                                                   Text="{Binding Metrics.Fps, StringFormat='{}{0:F0}', TargetNullValue='--'}" />
                                        <TextBlock Style="{StaticResource Lbl}"
                                                   Text="{Binding Metrics.Frametime, StringFormat='{}{0:F1} ms kare', TargetNullValue='kare süresi yok'}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6,0">
                                    <StackPanel>
                                        <TextBlock Text="CPU" Style="{StaticResource Lbl}" />
                                        <TextBlock Style="{StaticResource Val}"
                                                   Text="{Binding Metrics.CpuTemp, StringFormat='{}{0:F0}°C', TargetNullValue='--'}" />
                                        <TextBlock Style="{StaticResource Lbl}"
                                                   Text="{Binding Metrics.CpuLoad, StringFormat='yük {0:F0}%', TargetNullValue='yük yok'}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6,0">
                                    <StackPanel>
                                        <TextBlock Text="GPU" Style="{StaticResource Lbl}" />
                                        <TextBlock Style="{StaticResource Val}"
                                                   Text="{Binding Metrics.GpuTemp, StringFormat='{}{0:F0}°C', TargetNullValue='--'}" />
                                        <TextBlock Style="{StaticResource Lbl}"
                                                   Text="{Binding Metrics.GpuLoad, StringFormat='yük {0:F0}%', TargetNullValue='yük yok'}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="RAM" Style="{StaticResource Lbl}" />
                                        <TextBlock Style="{StaticResource Val}"
                                                   Text="{Binding Metrics.RamUsed, StringFormat='{}{0:F1} GB', TargetNullValue='--'}" />
                                        <TextBlock Style="{StaticResource Lbl}"
                                                   Text="{Binding Metrics.RamTotal, StringFormat='toplam {0:F0} GB', TargetNullValue=''}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0" MinHeight="240">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="Kare geçmişi" Style="{StaticResource Section}" />
                                        <TextBlock Text="{Binding SessionText}" Style="{StaticResource Lbl}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Grid.Row="1" Background="#08FFFFFF" CornerRadius="8" MinHeight="150">
                                        <Path Data="{Binding Metrics.Spark}" Stroke="#54E6A8" StrokeThickness="2"
                                              Stretch="Fill" Margin="6" />
                                    </Border>
                                    <Grid Grid.Row="2" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="GPU fan" Style="{StaticResource Lbl}" />
                                            <TextBlock Text="{Binding Metrics.GpuFan, StringFormat='{}{0:F0} rpm', TargetNullValue='--'}" />
                                            <TextBlock Text="{Binding Metrics.GpuFanPct, StringFormat='{}{0:F0}%', TargetNullValue=''}" Style="{StaticResource Lbl}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="CPU fan" Style="{StaticResource Lbl}" />
                                            <TextBlock Text="{Binding Metrics.CpuFan, StringFormat='{}{0:F0} rpm', TargetNullValue='--'}" />
                                            <TextBlock Text="{Binding Metrics.CpuClock, StringFormat='{}{0:F0} MHz', TargetNullValue=''}" Style="{StaticResource Lbl}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="GPU hotspot" Style="{StaticResource Lbl}" />
                                            <TextBlock Text="{Binding Metrics.GpuHotspot, StringFormat='{}{0:F0}°C', TargetNullValue='--'}" />
                                            <TextBlock Text="{Binding Metrics.GpuPower, StringFormat='{}{0:F0} W', TargetNullValue=''}" Style="{StaticResource Lbl}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="VRAM" Style="{StaticResource Lbl}" />
                                            <TextBlock Text="{Binding Metrics.VramUsed, StringFormat='{}{0:F1} GB', TargetNullValue='--'}" />
                                            <TextBlock Text="{Binding Metrics.VramTotal, StringFormat='/ {0:F0} GB', TargetNullValue=''}" Style="{StaticResource Lbl}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ui:Button Content="Taşıma modu" Click="MoveMode_Click" />
                                <ui:Button Content="Fanları varsayılana döndür" Click="RestoreFans_Click" Margin="8,0,0,0" />
                                <TextBlock Text="Ctrl+Alt+O göster/gizle · Ctrl+Alt+L taşıma" Style="{StaticResource Lbl}"
                                           VerticalAlignment="Center" Margin="14,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- LIBRARY -->
                    <Grid x:Name="PageLibrary" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Kütüphanem" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0,0,20,0" />
                                <ComboBox x:Name="SortBox" Width="170" SelectionChanged="Sort_Changed" VerticalAlignment="Center" />
                                <ui:Button Content="Yenile" Click="RefreshGames_Click" Margin="10,0,0,0" />
                                <ui:Button Content="EXE ekle" Click="AddExe_Click" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="LibCount" Style="{StaticResource Lbl}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ListBox Grid.Row="1" x:Name="GameList" ItemsSource="{Binding Filtered}"
                                 SelectionChanged="GameList_SelectionChanged"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource Tile}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="216">
                                        <Border Height="122" CornerRadius="8" ClipToBounds="True"
                                                Background="#141B26" BorderThickness="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#55FFFFFF" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#FFFFFF" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" FontSize="52" FontWeight="Bold"
                                                           Foreground="#1E2A3A" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Source="{Binding Wide}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Margin="2,8,0,1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="#7F8FA3"
                                                   Margin="2,0,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="SelName" Text="Oyun seç" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SelStats" Style="{StaticResource Lbl}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                    <TextBlock Text="FPS sınırı" Style="{StaticResource Lbl}" />
                                    <TextBox x:Name="TargetBox" Width="70" TextChanged="Target_Changed"
                                             ToolTip="Bu oyun için RTSS kare sınırı (0 = kapalı). İstatistiklerde hedef olarak da kullanılır." />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button x:Name="LaunchButton" Content="Başlat" Click="Launch_Click" Appearance="Primary" />
                                    <ui:Button Content="Sınırı uygula" Click="ApplyLimit_Click" Margin="8,0,0,0" />
                                    <ui:Button Content="Kaldır" Click="RemoveGame_Click" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- OVERLAY -->
                    <Grid x:Name="PageOverlay" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="Görünüm" Style="{StaticResource Section}" />
                            <ComboBox x:Name="ThemeBox" SelectionChanged="Theme_SelectionChanged" />
                            <TextBlock Text="Saydamlık" Style="{StaticResource Lbl}" Margin="0,14,0,4" />
                            <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1" ValueChanged="Opacity_Changed" />
                            <CheckBox x:Name="ClickThroughBox" Content="Tıkla-geç (fareyi oyuna bırakır)"
                                      Checked="ClickThrough_Toggle" Unchecked="ClickThrough_Toggle" Margin="0,14,0,0" />
                            <ui:Button Content="Taşıma modunu aç / kilitle" Click="MoveMode_Click" Margin="0,12,0,0" />
                            <Border Background="#0EFFFFFF" CornerRadius="8" Padding="10" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Kısayollar" Style="{StaticResource Section}" FontSize="13" />
                                    <TextBlock Text="Ctrl+Alt+O — overlay göster/gizle" Style="{StaticResource Lbl}" />
                                    <TextBlock Text="Ctrl+Alt+L — tıkla-geç aç/kapat" Style="{StaticResource Lbl}" />
                                    <TextBlock Text="Kilit açıkken sürükle, köşeden boyutlandır." Style="{StaticResource Lbl}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="#0EFFFFFF" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Bağlanabilir değerler" Style="{StaticResource Section}" FontSize="13" />
                                    <TextBlock Style="{StaticResource Lbl}" TextWrapping="Wrap"
                                               Text="Fps, Frametime, CpuName, CpuLoad, CpuTemp, CpuFan, CpuClock, GpuName, GpuLoad, GpuTemp, GpuHotspot, GpuFan, GpuFanPct, GpuClock, GpuPower, VramUsed, VramTotal, RamUsed, RamTotal, Target, Clock, Spark" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Tema kodu (XAML DataTemplate) — düzenle, uygula, kaydet"
                                       Style="{StaticResource Section}" FontSize="14" />
                            <TextBox Grid.Row="1" x:Name="EditorBox" AcceptsReturn="True" AcceptsTab="True"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" MinHeight="320" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <ui:Button Content="Uygula (canlı)" Click="ApplyTheme_Click" Appearance="Primary" />
                                <ui:Button Content="Kaydet" Click="SaveTheme_Click" Margin="8,0,0,0" />
                                <ui:Button Content="Varsayılana döndür" Click="ResetTheme_Click" Margin="8,0,0,0" />
                                <ui:Button Content="Klasörü aç" Click="OpenThemes_Click" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" x:Name="EditorError" Foreground="#FF8080" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Grid>
                    </Grid>

                    <!-- TUNING -->
                    <Grid x:Name="PageTune" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
                            <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Kare sınırlayıcı (RTSS)" Style="{StaticResource Section}" />
                                    <TextBlock x:Name="LimiterInfo" Style="{StaticResource Lbl}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="Global sınır" Style="{StaticResource Lbl}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox x:Name="GlobalLimitBox" Width="70" ToolTip="Tüm oyunlar için fps sınırı (0 = kapalı)" />
                                        <ui:Button Content="Uygula" Click="ApplyGlobalLimit_Click" Margin="8,0,0,0" />
                                        <ui:Button Content="Kapat" Click="ClearGlobalLimit_Click" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Lbl}" Margin="0,8,0,0"
                                               Text="Sınır RTSS'e yazılır (Front-Edge-Sync). Kütüphanede oyun seçip 'Sınırı uygula' ile oyun bazlı sınır konur. RTSS enjeksiyon kullanır: Vanguard/EAC/BattlEye'li oyunlarda risk alma." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="GPU (NVIDIA)" Style="{StaticResource Section}" />
                                    <TextBlock x:Name="GpuInfo" Style="{StaticResource Lbl}" />

                                    <TextBlock Text="Undervolt / verim profilleri" Style="{StaticResource Section}" Margin="0,18,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="Dengeli −10%" Click="UvBalanced_Click" />
                                        <ui:Button Content="Sessiz −20% + 1800 MHz" Click="UvQuiet_Click" Margin="8,0,0,0" />
                                        <ui:Button Content="Maks verim −30% + 1600 MHz" Click="UvEco_Click" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Lbl}" Margin="0,6,0,0"
                                               Text="Güç limiti + çekirdek saat tavanı birlikte uygulanır — NVAPI olmadan yapılabilen güvenli undervolt. Kapatınca geri alınır." />

                                    <TextBlock Text="Güç limiti (W)" Style="{StaticResource Lbl}" Margin="0,18,0,4" />
                                    <Slider x:Name="PowerSlider" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Power_Changed" />
                                    <TextBlock x:Name="PowerLabel" Style="{StaticResource Lbl}" />

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Çekirdek alt limit (MHz)" Style="{StaticResource Lbl}" />
                                            <TextBox x:Name="CoreMinBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Çekirdek üst limit (MHz)" Style="{StaticResource Lbl}" />
                                            <TextBox x:Name="CoreMaxBox" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Bellek alt limit (MHz)" Style="{StaticResource Lbl}" />
                                            <TextBox x:Name="MemMinBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Bellek üst limit (MHz)" Style="{StaticResource Lbl}" />
                                            <TextBox x:Name="MemMaxBox" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <ui:Button Content="Uygula" Click="ApplyTuning_Click" Appearance="Primary" />
                                        <ui:Button Content="Varsayılana döndür" Click="ResetTuning_Click" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="TuningStatus" Style="{StaticResource Lbl}" Margin="0,10,0,0" />
                                    <Border Background="#14FFB86B" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource Lbl}" TextWrapping="Wrap"
                                                   Text="Ayarlar nvidia-smi ile uygulanır; uygulama kapanınca/çökünce -rgc, -rmc ve varsayılan güç limiti geri yüklenir. Boş alan uygulanmaz, 0 = kilidi kaldır. Gerçek voltaj ofseti (curve) NVAPI gerektirir; burada yok." />
                                    </Border>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Fan kontrolü" Style="{StaticResource Section}" />
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Lbl}" Margin="0,0,0,6"
                                           Text="Sadece yazılabilir fanlar." />
                                <TextBlock x:Name="FanHint" DockPanel.Dock="Top" Style="{StaticResource Lbl}"
                                           Text="Sensörler yükleniyor…" Margin="0,0,0,10" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Fans}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Lbl}" />
                                                    <Slider Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                            Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="{Binding Value, StringFormat='{}{0:F0}%'}" Style="{StaticResource Lbl}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                <ScrollViewer x:Name="PageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,18">
                            <Image Source="Assets/logo.png" Width="64" Height="64" />
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Pulse" FontSize="26" FontWeight="Bold" />
                                <TextBlock Style="{StaticResource Lbl}" Margin="0,2,0,0"
                                           Text="Oyun içi performans overlay'i · kare sınırlayıcı · sensör paneli" />
                                <TextBlock x:Name="AboutVersion" Style="{StaticResource Lbl}" Margin="0,4,0,0"
                                           Text="v1.0.0 · .NET 10 / WPF" />
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="Assets/avatar.png" Width="76" Height="76" />
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Oğuzhan Mercan" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Lbl}"
                                               Text="programmer · Mercan Search and Development · Netherlands" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <ui:Button Content="GitHub" Tag="https://github.com/oguxmercan" Click="OpenLink_Click" />
                                        <ui:Button Content="X / Twitter" Tag="https://twitter.com/oguxmercan" Click="OpenLink_Click" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Teknolojiler ve lisans" Style="{StaticResource Section}" FontSize="14" />
                                <TextBlock Style="{StaticResource Lbl}"
                                           Text=".NET 10 · WPF + WPF-UI · LibreHardwareMonitor · Intel PresentMon 2.6 (MIT) · RivaTuner Statistics Server (kare sınırı / pacing) · nvidia-smi · WiX 5 (MSI)" />
                                <TextBlock Style="{StaticResource Lbl}" Margin="0,8,0,0"
                                           Text="Uyarı: RTSS enjeksiyonu kullanan rekabetçi oyunlarda (Vanguard / EAC / BattlEye) ban riski vardır." />
                                <TextBlock Style="{StaticResource Lbl}" Margin="0,10,0,0" Text="© 2026 Oğuzhan Mercan" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
